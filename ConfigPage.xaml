<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:NetworkMonitor.Maui.ViewModels;assembly=NetworkMonitorMaui"
             x:Class="NetworkMonitorAgent.ConfigPage"
             x:DataType="vm:ConfigPageViewModel"
             BackgroundColor="{AppThemeBinding Light={StaticResource LightBackground}, Dark={StaticResource DarkBackground}}">

    <ContentPage.Resources>
        <Style x:Key="CardFrameStyle" TargetType="Frame">
            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray900}}"/>
            <Setter Property="BorderColor" Value="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="HasShadow" Value="True"/>
        </Style>

        <Style x:Key="SectionTitleStyle" TargetType="Label">
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontAttributes" Value="Bold"/>
            <Setter Property="TextColor" Value="{DynamicResource Secondary}"/>
        </Style>

        <Style x:Key="KeyLabelStyle" TargetType="Label">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontAttributes" Value="Bold"/>
            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}"/>
        </Style>

        <Style x:Key="ValueLabelStyle" TargetType="Label">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource Gray100}}"/>
        </Style>
    </ContentPage.Resources>

    <Grid>
        <ScrollView>
            <VerticalStackLayout Spacing="24"
                                 Padding="24,32,24,48">

                <VerticalStackLayout Spacing="8"
                                     HorizontalOptions="Center">
                    <Image Source="logo.png"
                           SemanticProperties.Description="Quantum Network Monitor Agent logo"
                           HeightRequest="96"
                           HorizontalOptions="Center"/>
                    <Label Text="Quantum Network Monitor Agent"
                           FontSize="28"
                           FontAttributes="Bold"
                           TextColor="{DynamicResource Primary}"
                           HorizontalOptions="Center"/>
                    <Label Text="Review the agent configuration currently loaded from appsettings.json."
                           HorizontalOptions="Center"
                           HorizontalTextAlignment="Center"
                           WidthRequest="360"
                           FontSize="14"
                           TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}"/>
                </VerticalStackLayout>

                <Frame Style="{StaticResource CardFrameStyle}">
                    <VerticalStackLayout Spacing="18">
                        <Label Text="Configuration overview"
                               Style="{StaticResource SectionTitleStyle}"/>
                        <Label Text="Values are read-only—update appsettings.json via your deployment tooling when needed."
                               FontSize="14"
                               TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}"/>

                        <Grid ColumnDefinitions="Auto,*"
                              ColumnSpacing="18"
                              RowSpacing="14">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Label Grid.Row="0" Grid.Column="0" Text="Owner ID" Style="{StaticResource KeyLabelStyle}"/>
                            <Label Grid.Row="0" Grid.Column="1" Text="{Binding Owner}" Style="{StaticResource ValueLabelStyle}"/>

                            <Label Grid.Row="1" Grid.Column="0" Text="Monitor location" Style="{StaticResource KeyLabelStyle}"/>
                            <Label Grid.Row="1" Grid.Column="1" Text="{Binding MonitorLocation}" Style="{StaticResource ValueLabelStyle}"/>

                            <Label Grid.Row="2" Grid.Column="0" Text="Base FusionAuth URL" Style="{StaticResource KeyLabelStyle}"/>
                            <Label Grid.Row="2" Grid.Column="1" Text="{Binding BaseFusionAuthURL}" Style="{StaticResource ValueLabelStyle}" LineBreakMode="WordWrap"/>

                            <Label Grid.Row="3" Grid.Column="0" Text="Client ID" Style="{StaticResource KeyLabelStyle}"/>
                            <Label Grid.Row="3" Grid.Column="1" Text="{Binding ClientId}" Style="{StaticResource ValueLabelStyle}"/>

                            <Label Grid.Row="4" Grid.Column="0" Text="App ID" Style="{StaticResource KeyLabelStyle}"/>
                            <Label Grid.Row="4" Grid.Column="1" Text="{Binding AppID}" Style="{StaticResource ValueLabelStyle}"/>

                            <Label Grid.Row="5" Grid.Column="0" Text="Max task queue size" Style="{StaticResource KeyLabelStyle}"/>
                            <Label Grid.Row="5" Grid.Column="1" Text="{Binding MaxTaskQueueSize}" Style="{StaticResource ValueLabelStyle}"/>

                            <Label Grid.Row="6" Grid.Column="0" Text="Client auth URL" Style="{StaticResource KeyLabelStyle}"/>
                            <Label Grid.Row="6" Grid.Column="1" Text="{Binding ClientAuthUrl}" Style="{StaticResource ValueLabelStyle}" LineBreakMode="WordWrap"/>

                            <Label Grid.Row="7" Grid.Column="0" Text="Auth key" Style="{StaticResource KeyLabelStyle}"/>
                            <Label Grid.Row="7" Grid.Column="1" Text="{Binding AuthKey}" Style="{StaticResource ValueLabelStyle}" LineBreakMode="TailTruncation"/>
                        </Grid>
                    </VerticalStackLayout>
                </Frame>

                <Frame Style="{StaticResource CardFrameStyle}">
                    <VerticalStackLayout Spacing="16">
                        <Label Text="Reset agent configuration"
                               Style="{StaticResource SectionTitleStyle}"/>
                        <Label Text="Resetting removes appsettings.json and .env, disables the agent, and requires a restart before onboarding again."
                               FontSize="14"
                               TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}"
                               LineBreakMode="WordWrap"/>
                        <Button Text="Reset To Factory Defaults"
                                Command="{Binding ResetCommand}"
                                BackgroundColor="#B00020"
                                TextColor="White"
                                CornerRadius="8"
                                Padding="14,10"
                                FontAttributes="Bold"/>
                    </VerticalStackLayout>
                </Frame>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
