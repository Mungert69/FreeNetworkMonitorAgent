#!/usr/bin/env bash
set -e

# ========== CONFIG ==========
export INSTALL_DIR="/home/mahadeva/code/nmap-win-build"
export WORKDIR="/home/mahadeva/code/nmap-win-deps"

# OpenSSL (already built)
export OPENSSL_ROOT_DIR="/home/mahadeva/code/openssl-3.4.1-windows"
export OPENSSL_INCLUDE_DIR="$OPENSSL_ROOT_DIR/include"
export OPENSSL_LIB_DIR="$OPENSSL_ROOT_DIR/lib"  # or 'lib64', as appropriate

# Nmap Source
export NMAP_SRC_DIR="/home/mahadeva/code/nmap-7.97"

# ========== PREP ==========

mkdir -p "$WORKDIR" "$INSTALL_DIR"

# ========== Build Lua for Windows ==========
cd "$WORKDIR"
if [ ! -f lua-install/lib/liblua.a ]; then
    echo "=== Building Lua 5.4.7 ==="
    rm -rf lua-build lua-5.4.7
    mkdir -p lua-build && cd lua-build
    wget -nc https://www.lua.org/ftp/lua-5.4.7.tar.gz
    tar xzf lua-5.4.7.tar.gz
    cd lua-5.4.7
    # Use the 'mingw' target for Makefile if on MSYS2/MinGW
    make mingw CC=gcc MYCFLAGS="-O2 -DLUA_USE_WINDOWS" MYLDFLAGS="" MYLIBS=""
    mkdir -p "$WORKDIR/lua-install"/{include,lib}
    cp src/liblua.a "$WORKDIR/lua-install/lib"
    cp src/lua.h src/luaconf.h src/lualib.h src/lauxlib.h src/lua.hpp "$WORKDIR/lua-install/include"
    cd "$WORKDIR"
fi

# ========== Build libssh2 for Windows ==========
LIBSSH2_SRC="/home/mahadeva/code/libssh2-1.11.1"
LIBSSH2_INSTALL="$WORKDIR/libssh2-install"

if [ ! -d "$LIBSSH2_INSTALL" ]; then
    echo "=== Building libssh2 from $LIBSSH2_SRC ==="
    cd "$LIBSSH2_SRC"
    autoreconf -fi
    ./configure \
      --host=x86_64-w64-mingw32 \
      --with-openssl \
      --with-libssl-prefix="$OPENSSL_ROOT_DIR" \
      --prefix="$LIBSSH2_INSTALL" \
      --disable-examples-build \
      --disable-tests-build \
      CC="x86_64-w64-mingw32-gcc" \
      AR="x86_64-w64-mingw32-ar" \
      RANLIB="x86_64-w64-mingw32-ranlib" \
      CFLAGS="-O2 -DLIBSSH2_WIN32"
    make -j$(nproc)
    make install
    cd "$WORKDIR"
fi

# ========== Build Nmap for Windows ==========
cd "$NMAP_SRC_DIR"
make distclean || true
find . -name '*.o' -delete
find . -name '*.a' -delete
find . -name '*.dll' -delete
find . -name '*.exe' -delete

# Prepare configure flags
CONFIGURE_FLAGS=(
  --host=x86_64-w64-mingw32
  --without-zenmap
  --with-pcre=included
  --with-libpcap=included
  --with-libdnet=included
  --without-ndiff
  --without-nmap-update
  --without-ncat
  --with-liblua="$WORKDIR/lua-install"
  --with-liblua-includes="$WORKDIR/lua-install/include"
  --without-nping
  --with-openssl="$OPENSSL_ROOT_DIR"
  --with-openssl-includes="$OPENSSL_INCLUDE_DIR"
  --with-libssh2="$WORKDIR/libssh2-install"
  --with-libssh2-includes="$WORKDIR/libssh2-install/include"
  --with-libssh2-libraries="$WORKDIR/libssh2-install/lib"
  --enable-static
  --prefix="$INSTALL_DIR"
)

./configure "${CONFIGURE_FLAGS[@]}"

make -j$(nproc)

# ========== Collect Artifacts ==========
echo "Collecting final artifacts..."
mkdir -p "$INSTALL_DIR"
cp nmap.exe "$INSTALL_DIR/" || true
cp -r nselib "$INSTALL_DIR/" || true

for f in nmap-service-probes nmap-payloads nmap-services \
         nmap-mac-prefixes nmap-os-db nmap-protocols nmap-rpc \
         nse_main.lua nmap.xsl nmap.dtd; do
  [ -f "$NMAP_SRC_DIR/$f" ] && cp "$NMAP_SRC_DIR/$f" "$INSTALL_DIR/"
done

[ -d scripts ] && cp -r scripts "$INSTALL_DIR/"

# Copy your built OpenSSL DLLs if dynamic, or static .a if statically linked

echo "✅ Build and packaging complete. Artifacts in: $INSTALL_DIR"

