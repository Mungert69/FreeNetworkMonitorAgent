#!/bin/bash
set -e

# ====== Config ======
export NDK_ROOT="/lib/android-sdk/ndk/28.1.13356709"
export NDK_COMPILER_PREFIX="armv7a-linux-androideabi"
export API_LEVEL="21"
export INSTALL_DIR="/home/mahadeva/code/nmap-android-build"
export WORKDIR="/home/mahadeva/code/nmap-build-deps"

# ====== OpenSSL ======
export OPENSSL_ROOT_DIR="/home/mahadeva/code/openssl-3.4.1-android"
export OPENSSL_INCLUDE_DIR="$OPENSSL_ROOT_DIR/include"
export OPENSSL_CRYPTO_LIBRARY="$OPENSSL_ROOT_DIR/libcrypto.a"
export OPENSSL_SSL_LIBRARY="$OPENSSL_ROOT_DIR/libssl.a"

# ====== Toolchain ======
export TOOLCHAIN_BIN="$NDK_ROOT/toolchains/llvm/prebuilt/linux-x86_64/bin"
export PATH="$TOOLCHAIN_BIN:$PATH"
export CC="${NDK_COMPILER_PREFIX}${API_LEVEL}-clang"
export CXX="${NDK_COMPILER_PREFIX}${API_LEVEL}-clang++"
export AR="llvm-ar"
export RANLIB="llvm-ranlib"
export CFLAGS="-fPIE -fPIC -DANDROID -fvisibility=hidden "
export CXXFLAGS="-fPIE -fPIC -DANDROID -fvisibility=hidden "
export LDFLAGS="-pie "

# NMAP SOURCE DIRECTORY
export NMAP_SRC_DIR="/home/mahadeva/code/nmap-7.97"

# ====== Make Output Directories ======
mkdir -p "$WORKDIR" "$INSTALL_DIR"

# ====== Build Lua ======
cd "$WORKDIR"
if [ ! -f lua-install/lib/liblua.a ]; then
    echo "=== Building Lua 5.4.7 ==="
    rm -rf lua-build lua-5.4.7
    mkdir -p lua-build && cd lua-build
    wget -nc https://www.lua.org/ftp/lua-5.4.7.tar.gz
    tar xzf lua-5.4.7.tar.gz
    cd lua-5.4.7
    sed -i 's/fseeko/fseek/g; s/ftello/ftell/g' src/liolib.c
    export LUA_ANDROID_FLAGS="-DLUA_USE_LINUX -D_LARGEFILE_SOURCE -D_FILE_OFFSET_BITS=64"
    for f in src/*.c; do
        [ "$f" = "src/luac.c" ] && continue
        $CC $CFLAGS $LUA_ANDROID_FLAGS -c $f -o ${f%.c}.o
    done
    $AR rcs src/liblua.a src/*.o
    mkdir -p "$WORKDIR/lua-install"/{include,lib}
    cp src/liblua.a "$WORKDIR/lua-install/lib"
    cp src/lua.h src/luaconf.h src/lualib.h src/lauxlib.h src/lua.hpp "$WORKDIR/lua-install/include"
    cd "$WORKDIR"
fi

# ====== Build libssh2 for Android (AUTOTOOLS) ======
cd /home/mahadeva/code
LIBSSH2_INSTALL="$WORKDIR/libssh2-install"
export LIBSSH2_SRC="libssh2-1.11.1"

rm -rf "$LIBSSH2_INSTALL"
cd "$LIBSSH2_SRC"

./configure \
  --host=arm-linux-androideabi \
  --with-openssl \
  --with-libssl-prefix="$OPENSSL_ROOT_DIR" \
  --with-libssl-include="$OPENSSL_INCLUDE_DIR" \
  --prefix="$LIBSSH2_INSTALL" \
  --disable-examples-build \
  --disable-tests-build \
  CC="$CC" \
  AR="$AR" \
  RANLIB="$RANLIB" \
  CFLAGS="$CFLAGS" \
  LDFLAGS="$LDFLAGS"

make -j$(nproc)
make install

cd "$WORKDIR"

# ====== Build Nmap ======
cd /home/mahadeva/code/nmap-7.97

make distclean || true
find . -name '*.o' -delete
find . -name '*.a' -delete
find . -name '*.so' -delete

# Force route-none backend for Android
cp libdnet-stripped/src/route-none.c libdnet-stripped/src/route-linux.c

# ====== Ensure OpenSSL .a files are in lib/ subdirectory for Nmap ======
cd "$OPENSSL_ROOT_DIR"
mkdir -p lib
if [ -f libcrypto.a ]; then mv -f libcrypto.a lib/; fi
if [ -f libssl.a ]; then mv -f libssl.a lib/; fi
cd "$NMAP_SRC_DIR"

# ====== Configure Nmap (with Lua & OpenSSL) ======
./configure \
  --host=arm-linux-androideabi \
  --without-subversion \
  --without-zenmap \
  --with-pcre=/usr \
  --with-libpcap=included \
  --with-pcap=linux \
  --with-libdnet=included \
  --without-ndiff \
  --without-nmap-update \
  --without-ncat \
  --with-liblua="$WORKDIR/lua-install" \
  --with-liblua-includes="$WORKDIR/lua-install/include" \
  --without-nping \
  --with-openssl="$OPENSSL_ROOT_DIR" \
  --with-openssl-includes="$OPENSSL_INCLUDE_DIR" \
  --with-libssh2="$WORKDIR/libssh2-install" \
  --with-libssh2-includes="$WORKDIR/libssh2-install/include" \
  --with-libssh2-libraries="$WORKDIR/libssh2-install/lib" \
  --enable-static \
  --prefix="$INSTALL_DIR"

make


# ====== Collect Artifacts ======
echo "Collecting final artifacts..."
mkdir -p "$INSTALL_DIR"
cp nmap "$INSTALL_DIR/" || true
cp -r nselib "$INSTALL_DIR/" || true

for f in nmap-service-probes nmap-payloads nmap-services \
         nmap-mac-prefixes nmap-os-db nmap-protocols nmap-rpc \
         nse_main.lua nmap.xsl nmap.dtd; do
  [ -f "/home/mahadeva/code/nmap-7.97/$f" ] && \
    cp "/home/mahadeva/code/nmap-7.97/$f" "$INSTALL_DIR/"
done

# Copy libc++_shared and openssl.so already included in copy-to-lib64
mkdir -p "$INSTALL_DIR/copy-to-lib64/"
cp "$NDK_ROOT/toolchains/llvm/prebuilt/linux-x86_64/sysroot/usr/lib/arm-linux-androideabi/libc++_shared.so" \
   "$INSTALL_DIR/copy-to-lib64/"

[ -d scripts ] && cp -r scripts "$INSTALL_DIR/"

echo "✅ Build and packaging complete. Artifacts in: $INSTALL_DIR"
echo "NOW build openssl.so ie lua-openssl this is for lua to work . try using the script build_lua_openssl_objects.sh "

