#!/bin/bash

# Check if the keypass file exists
if [ ! -f ~/code/securefiles/keypass ]; then
    echo "Error: keypass file not found at ~/code/securefiles/keypass"
    exit 1
fi

# Source the keypass file to set environment variables
. ~/code/securefiles/keypass

# Proceed with the rest of the commands
dotnet clean NetworkMonitorAgent-Android.csproj
dotnet publish ~/code/NetworkMonitorLib/NetworkMonitor-Maui-Android.csproj -c Release -r android --self-contained true
cp ~/code/NetworkMonitorLib/bin/Release/net10.0-android/android/NetworkMonitor-Maui-Android.dll ~/code/FreeNetworkMonitorAgent/Resources/Raw/dlls/NetworkMonitor.dll

cp ./Resources/Raw/appsettings-live.json ./Resources/Raw/appsettings.json
dotnet build -c Release -f net10.0-android NetworkMonitorAgent-Android.csproj

