set -e

export NDK_ROOT=/lib/android-sdk/ndk/28.1.13356709
export PATH="$NDK_ROOT/toolchains/llvm/prebuilt/linux-x86_64/bin:${PATH}"
export CC=armv7a-linux-androideabi21-clang
export CXX=armv7a-linux-androideabi21-clang++
export AR=llvm-ar
export RANLIB=llvm-ranlib
export CFLAGS="-fPIE -fPIC -DANDROID -fvisibility=hidden "
export CXXFLAGS="-fPIE -fPIC -DANDROID -fvisibility=hidden "
export LDFLAGS="-pie "

# Clean previous builds
make distclean || true
find . -name '*.o' -delete
find . -name '*.a' -delete
find . -name '*.so' -delete

# --- PATCH netutil.cc to avoid unresolved symbols for Android ---
# This creates a stub for getsysroutes_dnet if __ANDROID__ is defined
PATCH_FILE="libnetutil/netutil.cc"
if ! grep -q 'ANDROID ROUTE STUB' "$PATCH_FILE"; then
  echo "Patching $PATCH_FILE for Android route stubs..."
  # Insert the stub at the top of the file
  awk '
    BEGIN { patched=0 }
    /^int getsysroutes_dnet/ && patched==0 {
      print "#ifdef __ANDROID__  // ANDROID ROUTE STUB\nint getsysroutes_dnet(int *family, char *buf, unsigned int buflen) { return -1; }\n#else";
      patched=1
    }
    { print }
    END { if(patched) print "#endif // __ANDROID__" }
  ' "$PATCH_FILE" > "$PATCH_FILE.tmp" && mv "$PATCH_FILE.tmp" "$PATCH_FILE"
fi
# Force use of the stub (no-op) route backend for Android
echo "Overwriting route-linux.c with route-none.c for Android build..."
cp libdnet-stripped/src/route-none.c libdnet-stripped/src/route-linux.c

# Configure nmap
./configure \
  --host=arm-linux-androideabi \
  --without-subversion \
  --without-liblua \
  --without-zenmap \
  --with-pcre=/usr \
  --with-libpcap=included \
  --with-pcap=linux \
  --with-libdnet=included \
  --without-ndiff \
  --without-nmap-update \
  --without-ncat \
  --without-liblua \
  --without-nping \
  --without-openssl \
  --enable-static \
  --prefix=/home/mahadeva/code/nmap-android-build

make
BUILDROOT=/home/mahadeva/code/nmap-android-build
mkdir -p "$BUILDROOT"
cp nmap "$BUILDROOT/"                # <-- Copy the binary, always
for f in nmap-service-probes nmap-payloads nmap-services nmap-mac-prefixes nmap-os-db nmap-protocols nmap-rpc nmap.xsl; do
    [ -f "$f" ] && cp "$f" "$BUILDROOT/"
done
cp "$NDK_ROOT/toolchains/llvm/prebuilt/linux-x86_64/sysroot/usr/lib/arm-linux-androideabi/libc++_shared.so" "$INSTALL_DIR/"

[ -d scripts ] && cp -r scripts "$BUILDROOT/"


