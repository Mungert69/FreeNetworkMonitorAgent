#!/usr/bin/env bash
set -e
###############################################################################
#  build-linux-provider.sh
#  Native x86-64 Linux build of:
#    • liboqs-0.13.0 (static, PIC)
#    • oqs-provider-0.9.0  (shared module linked to OpenSSL 3.x)
###############################################################################

# ───── Config ────────────────────────────────────────────────────────────────
export JOBS="${JOBS:-$(nproc)}"

# Where temporary builds & final artefacts go
export WORKDIR="$HOME/code/oqs-linux-build"
export LIBOQS_INSTALL_DIR="$HOME/code/liboqs-linux"
export OQS_PROVIDER_INSTALL_DIR="$HOME/code/oqs-provider-linux"

# ───── OpenSSL (already built, or system) ───────────────────────────────────
#  • Point OPENSSL_ROOT_DIR at a *prefix* containing lib/libcrypto.a|so & include/
#  • If you’re happy with distro OpenSSL 3.x, leave these commented out and
#    OpenSSL will be found automatically via pkg-config.
#
# export OPENSSL_ROOT_DIR="$HOME/code/openssl-3.4.1-linux"
# export OPENSSL_INCLUDE_DIR="$OPENSSL_ROOT_DIR/include"
# export OPENSSL_CRYPTO_LIBRARY="$OPENSSL_ROOT_DIR/lib/libcrypto.a"
# export OPENSSL_SSL_LIBRARY="$OPENSSL_ROOT_DIR/lib/libssl.a"

# ───── Host compiler flags (change if you prefer clang) ─────────────────────
export CC="${CC:-gcc}"
export CXX="${CXX:-g++}"
export CFLAGS="${CFLAGS:--O2 -fPIC}"
export CXXFLAGS="$CFLAGS"
export LDFLAGS="${LDFLAGS:-}"

# ───── CMake generator (Ninja if available) ─────────────────────────────────
if command -v ninja >/dev/null 2>&1; then
  GEN="Ninja"
else
  GEN="Unix Makefiles"
fi
cmake_gen()  { cmake -G "$GEN" "$@"; }
build_gen()  { cmake --build "$1" -- -j"$JOBS"; }

# ───── Source archives (already downloaded) ─────────────────────────────────
LIBOQS_ZIP="$PWD/0.13.0.zip"
OQSPROV_ZIP="$PWD/0.9.0.zip"
LIBOQS_SRC="$WORKDIR/liboqs-0.13.0"
OQS_PROVIDER_SRC="$WORKDIR/oqs-provider-0.9.0"

# ───── Prep dirs ────────────────────────────────────────────────────────────
mkdir -p "$WORKDIR" "$LIBOQS_INSTALL_DIR" "$OQS_PROVIDER_INSTALL_DIR"
cd "$WORKDIR"

echo "────────────────────────────────────────────────────────"
echo "Generator           : $GEN"
echo "Build jobs          : $JOBS"
echo "liboqs install      : $LIBOQS_INSTALL_DIR"
echo "oqs-provider instal : $OQS_PROVIDER_INSTALL_DIR"
echo "────────────────────────────────────────────────────────"

# ───── Unpack sources ───────────────────────────────────────────────────────
if [ ! -d "$LIBOQS_SRC" ]; then
  unzip -q "$LIBOQS_ZIP" -d "$WORKDIR"
  mv "$WORKDIR"/liboqs-* "$LIBOQS_SRC" 2>/dev/null || true
fi

if [ ! -d "$OQS_PROVIDER_SRC" ]; then
  unzip -q "$OQSPROV_ZIP" -d "$WORKDIR"
  mv "$WORKDIR"/oqs-provider-* "$OQS_PROVIDER_SRC" 2>/dev/null || true
fi

# ───── Build liboqs ─────────────────────────────────────────────────────────
if [ ! -f "$LIBOQS_INSTALL_DIR/usr/local/lib/liboqs.a" ]; then
  echo "🍃  Building liboqs (native x86-64)…"
  cmake_gen -S "$LIBOQS_SRC" -B "$LIBOQS_SRC/build" \
            -DCMAKE_POSITION_INDEPENDENT_CODE=ON \
            -DBUILD_SHARED_LIBS=OFF \
            -DOQS_USE_OPENSSL=OFF
  build_gen "$LIBOQS_SRC/build"
  DESTDIR="$LIBOQS_INSTALL_DIR" \
cmake --install "$LIBOQS_SRC/build-$ABI" \
      --prefix /usr/local

else
  echo "✓ liboqs already built."
fi

# ───── Build oqs-provider ───────────────────────────────────────────────────
echo "🔗  Building oqs-provider…"
cmake_gen -S "$OQS_PROVIDER_SRC" -B "$OQS_PROVIDER_SRC/build" \
          ${OPENSSL_ROOT_DIR:+-DOPENSSL_ROOT_DIR="$OPENSSL_ROOT_DIR"} \
          ${OPENSSL_INCLUDE_DIR:+-DOPENSSL_INCLUDE_DIR="$OPENSSL_INCLUDE_DIR"} \
          ${OPENSSL_CRYPTO_LIBRARY:+-DOPENSSL_CRYPTO_LIBRARY="$OPENSSL_CRYPTO_LIBRARY"} \
          ${OPENSSL_SSL_LIBRARY:+-DOPENSSL_SSL_LIBRARY="$OPENSSL_SSL_LIBRARY"} \
          -Dliboqs_DIR="$LIBOQS_INSTALL_DIR/usr/local/lib/cmake/liboqs" \
          -DOPENSSL_MODULES_DIR="lib/ossl-modules"
build_gen "$OQS_PROVIDER_SRC/build"

cmake --install "$OQS_PROVIDER_SRC/build" \
      --prefix "$OQS_PROVIDER_INSTALL_DIR/usr/local"

# ───── Summary ──────────────────────────────────────────────────────────────
echo
echo "🎉  Build complete."
echo "    liboqs       → $LIBOQS_INSTALL_DIR/usr/local"
echo "    oqs-provider → $OQS_PROVIDER_INSTALL_DIR/usr/local"

