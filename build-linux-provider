#!/usr/bin/env bash
set -e
###############################################################################
#  build-linux-provider.sh – native x86-64 bundle (Kyber-enabled, unzip-fix)
###############################################################################

JOBS="${JOBS:-$(nproc)}"

WORKDIR="$HOME/code/oqs-linux-build"
LIBOQS_INSTALL_DIR="$HOME/code/liboqs-linux"
OQS_PROVIDER_INSTALL_DIR="$HOME/code/oqs-provider-linux"

OPENSSL_ROOT_DIR="$HOME/code/openssl-3.4.1-linux"
OPENSSL_INCLUDE_DIR="$OPENSSL_ROOT_DIR/include"
OPENSSL_CRYPTO_LIBRARY="$OPENSSL_ROOT_DIR/lib/libcrypto.a"
OPENSSL_SSL_LIBRARY="$OPENSSL_ROOT_DIR/lib/libssl.a"

export CC="${CC:-gcc}"  CXX="${CXX:-g++}"
export CFLAGS="${CFLAGS:--O2 -fPIC}"  CXXFLAGS="$CFLAGS"

GEN=$(command -v ninja >/dev/null 2>&1 && echo "Ninja" || echo "Unix Makefiles")
cmake_gen() { cmake -G "$GEN" "$@"; }
build_gen() { cmake --build "$1" -- -j"$JOBS"; }

LIBOQS_ZIP="$PWD/0.11.0.zip"
OQSPROV_ZIP="$PWD/0.7.0.zip"
LIBOQS_SRC="$WORKDIR/liboqs-0.11.0"
OQS_PROVIDER_SRC="$WORKDIR/oqs-provider-0.7.0"

mkdir -p "$WORKDIR" "$LIBOQS_INSTALL_DIR" "$OQS_PROVIDER_INSTALL_DIR"
cd "$WORKDIR"

# ── Unpack liboqs (only if absent) ───────────────────────────────────────────
if [ ! -d "$LIBOQS_SRC" ]; then
  unzip -q "$LIBOQS_ZIP" -d "$WORKDIR"
  srcdir=$(ls -d "$WORKDIR"/liboqs-* | head -n1)          # capture extracted dir
  if [ "$srcdir" != "$LIBOQS_SRC" ]; then
    mv "$srcdir" "$LIBOQS_SRC"
  fi
fi

# ── Unpack oqs-provider (only if absent) ─────────────────────────────────────
if [ ! -d "$OQS_PROVIDER_SRC" ]; then
  unzip -q "$OQSPROV_ZIP" -d "$WORKDIR"
  srcdir=$(ls -d "$WORKDIR"/oqs-provider-* | head -n1)
  if [ "$srcdir" != "$OQS_PROVIDER_SRC" ]; then
    mv "$srcdir" "$OQS_PROVIDER_SRC"
  fi
fi

###############################################################################
# 1. Build liboqs (static, all algorithms – keeps Kyber)
###############################################################################
if [ ! -f "$LIBOQS_INSTALL_DIR/usr/local/lib/liboqs.a" ]; then
  cmake_gen -S "$LIBOQS_SRC" -B "$LIBOQS_SRC/build" \
            -DBUILD_SHARED_LIBS=OFF \
            -DCMAKE_POSITION_INDEPENDENT_CODE=ON \
            -DOQS_USE_OPENSSL=OFF \
            -DOQS_ALGS_ENABLED=All \
	              -DOQS_ENABLE_KEM_KYBER=ON \
          -DOQS_ENABLE_KEM_kyber_512=ON \
          -DOQS_ENABLE_KEM_kyber_768=ON \
          -DOQS_ENABLE_KEM_kyber_1024=ON
  build_gen "$LIBOQS_SRC/build"
  DESTDIR="$LIBOQS_INSTALL_DIR" cmake --install "$LIBOQS_SRC/build" --prefix /usr/local
fi

###############################################################################
# 2. Enable Kyber in oqs-provider and regenerate sources
###############################################################################
export LIBOQS_SRC_DIR="$LIBOQS_SRC"

sed -i "/family: .*CRYSTALS-Kyber/,/enable_kem/ s/enable_kem: false/enable_kem: true/" \
       "$OQS_PROVIDER_SRC/oqs-template/generate.yml"

REQ="$OQS_PROVIDER_SRC/oqs-template/requirements.txt"
if [[ -n "$VIRTUAL_ENV" ]]; then
  python3 -m pip install -q -r "$REQ"
else
  python3 -m pip install -q  -r "$REQ"
fi

(
  cd "$OQS_PROVIDER_SRC"
  python3 oqs-template/generate.py
)

###############################################################################
# 3. Build oqs-provider (shared .so)
###############################################################################
cmake_gen -S "$OQS_PROVIDER_SRC" -B "$OQS_PROVIDER_SRC/build" \
          -DBUILD_TESTING=OFF \
          -DOPENSSL_MODULES_DIR="lib/ossl-modules" \
          -DCMAKE_INSTALL_BINDIR="lib/ossl-modules" \
          -Dliboqs_DIR="$LIBOQS_INSTALL_DIR/usr/local/lib/cmake/liboqs" \
          ${OPENSSL_ROOT_DIR:+-DOPENSSL_ROOT_DIR="$OPENSSL_ROOT_DIR"} \
          ${OPENSSL_INCLUDE_DIR:+-DOPENSSL_INCLUDE_DIR="$OPENSSL_INCLUDE_DIR"} \
          ${OPENSSL_CRYPTO_LIBRARY:+-DOPENSSL_CRYPTO_LIBRARY="$OPENSSL_CRYPTO_LIBRARY"} \
          ${OPENSSL_SSL_LIBRARY:+-DOPENSSL_SSL_LIBRARY="$OPENSSL_SSL_LIBRARY"}
build_gen "$OQS_PROVIDER_SRC/build"

cmake --install "$OQS_PROVIDER_SRC/build" --prefix "$OQS_PROVIDER_INSTALL_DIR/usr/local"

# ── Fail-safe copy ───────────────────────────────────────────────────────────
if [ ! -f "$OQS_PROVIDER_INSTALL_DIR/usr/local/lib/ossl-modules/oqsprovider.so" ]; then
  so_src=$(find "$OQS_PROVIDER_SRC/build" "$OPENSSL_ROOT_DIR" -name 'oqsprovider*.so' | head -n1)
  if [ -n "$so_src" ]; then
    install -d "$OQS_PROVIDER_INSTALL_DIR/usr/local/lib/ossl-modules"
    install -m755 "$so_src" "$OQS_PROVIDER_INSTALL_DIR/usr/local/lib/ossl-modules/"
  fi
fi

# ── Summary ──────────────────────────────────────────────────────────────────
echo -e "\n🎉  Bundle ready with Kyber support:"
if command -v tree >/dev/null 2>&1; then
  tree -L 3 "$OQS_PROVIDER_INSTALL_DIR/usr/local"
else
  find "$OQS_PROVIDER_INSTALL_DIR/usr/local" -maxdepth 3 -print
fi

echo -e "\nPackage with:"
echo "  tar czf oqs-linux-bundle.tar.gz -C $OQS_PROVIDER_INSTALL_DIR usr"

