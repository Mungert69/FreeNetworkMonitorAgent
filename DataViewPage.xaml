<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:NetworkMonitor.Maui.Controls;assembly=NetworkMonitorMaui"
             xmlns:shapes="clr-namespace:Microsoft.Maui.Controls.Shapes;assembly=Microsoft.Maui.Controls"
             x:Class="NetworkMonitorAgent.DataViewPage"
             x:Name="ThisPage"
             BackgroundColor="{AppThemeBinding Light={StaticResource LightBackground}, Dark={StaticResource DarkBackground}}">

    <ContentPage.Resources>
        <Style x:Key="CardFrameStyle" TargetType="Frame">
            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray900}}"/>
            <Setter Property="BorderColor" Value="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="HasShadow" Value="True"/>
        </Style>

        <Style x:Key="SectionTitleStyle" TargetType="Label">
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontAttributes" Value="Bold"/>
            <Setter Property="TextColor" Value="{DynamicResource Secondary}"/>
        </Style>

        <Style x:Key="SectionCaptionStyle" TargetType="Label">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}"/>
        </Style>

        <Style x:Key="KeyLabelStyle" TargetType="Label">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontAttributes" Value="Bold"/>
            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource Gray200}}"/>
        </Style>
    </ContentPage.Resources>

    <Grid>
        <ScrollView>
            <VerticalStackLayout Spacing="24"
                                 Padding="24,32,24,48">

                <VerticalStackLayout Spacing="6"
                                     HorizontalOptions="Center">
                    <Image Source="logo.png"
                           SemanticProperties.Description="Quantum Network Monitor Agent logo"
                           HeightRequest="96"
                           HorizontalOptions="Center"/>
                    <Label Text="Quantum Network Monitor Agent"
                           FontSize="28"
                           FontAttributes="Bold"
                           TextColor="{DynamicResource Primary}"
                           HorizontalOptions="Center"/>
                    <Label Text="Visualise agent telemetry and node status in real time."
                           Style="{StaticResource SectionCaptionStyle}"
                           HorizontalOptions="Center"
                           HorizontalTextAlignment="Center"
                           WidthRequest="320"/>
                </VerticalStackLayout>

                <Frame Style="{StaticResource CardFrameStyle}">
                    <VerticalStackLayout Spacing="14">
                        <Label Text="Agent overview"
                               Style="{StaticResource SectionTitleStyle}"/>
                        <Label Text="Enable animation to emphasise status transitions between monitored hosts."
                               Style="{StaticResource SectionCaptionStyle}"/>

                        <Grid ColumnDefinitions="*,Auto"
                              ColumnSpacing="12"
                              IsVisible="{Binding HasData}">
                            <Label Text="Toggle animations"
                                   Style="{StaticResource KeyLabelStyle}"
                                   VerticalOptions="Center"/>
                            <Switch Grid.Column="1"
                                    IsToggled="{Binding IsAnimationOn}"
                                    VerticalOptions="Center"/>
                        </Grid>

                        <Border StrokeThickness="1"
                                Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}"
                                Background="{AppThemeBinding Light={StaticResource LightSecondaryBackground}, Dark={StaticResource DarkSecondaryBackground}}"
                                Padding="16"
                                Margin="0,8,0,0"
                                IsVisible="{Binding HasNoData}">
                            <Border.StrokeShape>
                                <shapes:RoundRectangle CornerRadius="12"/>
                            </Border.StrokeShape>
                            <Label Text="Waiting for telemetry. Add monitored hosts to populate this view."
                                   Style="{StaticResource SectionCaptionStyle}"
                                   HorizontalTextAlignment="Center"/>
                        </Border>
                    </VerticalStackLayout>
                </Frame>

                <Frame Style="{StaticResource CardFrameStyle}"
                       Padding="12">
                    <VerticalStackLayout Spacing="16">
                        <Label Text="Host status map"
                               Style="{StaticResource SectionTitleStyle}"/>
                        <Label Text="Tap a node to view recent performance metrics."
                               Style="{StaticResource SectionCaptionStyle}"/>

                        <AbsoluteLayout x:Name="circleLayout"
                                        WidthRequest="320"
                                        HeightRequest="260"
                                        HorizontalOptions="Center"
                                        BindableLayout.ItemsSource="{Binding MPIndicators}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate>
                                    <AbsoluteLayout WidthRequest="{Binding DiameterPixels, Converter={StaticResource MinTapSizeConverter}}"
                                                    HeightRequest="{Binding DiameterPixels, Converter={StaticResource MinTapSizeConverter}}"
                                                    AbsoluteLayout.LayoutBounds="{Binding ., Converter={StaticResource BoundsConverter}}"
                                                    AbsoluteLayout.LayoutFlags="PositionProportional">
                                        <Grid HorizontalOptions="Center"
                                              VerticalOptions="Center">
                                            <controls:StatusIndicator WidthRequest="{Binding DiameterPixels}"
                                                                       HeightRequest="{Binding DiameterPixels}"
                                                                       IsUp="{Binding MonitorStatus.IsUp}"
                                                                       PacketsLostPercentage="{Binding PacketsLostPercentage}"
                                                                       RoundTripTimeAverage="{Binding RoundTripTimeAverage}"
                                                                       DiameterPixels="{Binding DiameterPixels}"
                                                                       IsAnimated="{Binding IsAnimated}"
                                                                       Tapped="OnStatusIndicatorTapped"/>
                                        </Grid>
                                    </AbsoluteLayout>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </AbsoluteLayout>
                    </VerticalStackLayout>
                </Frame>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
